<!DOCTYPE html>
<html lang="zh-cn">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>

<body>
    <div id="form-container">登录</h1>
        <form method="get" autocomplete="off">
            <a href="../">返回首页</a>
            <div>
                <label for="accountType" class="bt">账号类型</label>
                <select id="accountType">
                    <option value="普通用户">普通用户</option>
                    <option value="vip用户">vip用户</option>
                </select>
            </div>

            <div>
                <label for="username" class="bt">昵 称</label>
                <input type="text" id="username" name="username" maxlength="11" placeholder="输入账号ID">
            </div>

            <div>
                <label for="password" class="bt">密 码</label>
                <input type="password" id="password" name="password" placeholder="输入密码" required>
            </div>

            <input type="submit" id="login" value="登录">
        </form>

        <div>
            <a href="register" class="隐藏">没有账号？点这里注册！</a>
        </div>
    </div>
</body>

</html>
